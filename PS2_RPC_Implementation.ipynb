    "fig, axes = plt.subplots(1, 3, figsize=(20, 6), facecolor='#0d0d1a')\n",
    "\n",
    "# Score distribution\n",
    "ax = axes[0]\n",
    "ax.hist(phone_scores['p_rpc_beta'], bins=50, color='#00D4FF', edgecolor='#0d0d1a', alpha=0.85)\n",
    "ax.set_title(f'Beta-Decay P(RPC) Distribution\\n(n={len(phone_scores):,} phones)', color='white', fontsize=12)\n",
    "ax.set_xlabel('P(RPC)', color='#AAAAAA', fontsize=9)\n",
    "ax.tick_params(colors='#AAAAAA')\n",
    "ax.set_facecolor('#1a1a2e')\n",
