    "---\n",
    "## ⚡ Step 6 — Decision Table + EVT Skip-Trace Ranking\n",
    "\n",
    "### Decision Table\n",
    "| HMM State | GBDT Score | Action |\n",
    "|-----------|------------|--------|\n",
    "| valid | P(RPC) ≥ 0.4 | Dial at best time slot |\n",
    "| avoiding | — | Switch channel (WhatsApp/field) |\n",
    "| switched_off | — | Retry in 48h |\n",
    "| invalid / recycled / third_party | — | **Suppress immediately** |\n",
    "| All dead (no valid phones) | — | Trigger skip-trace if EVT > 0 |\n",
    "\n",
    "### Skip-Trace EVT Formula\n",
    "$$EVT = P(\\text{find valid CP}) \\times P(\\text{recover} | \\text{reached}) \\times \\text{Outstanding} - C_{\\text{trace}}$$"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─── Step 6: Decision Table + EVT Skip-Trace Ranking ───────────────────────────\n",
    "\n",
    "# Build master phone-level scorecard\n",
    "scorecard = phones.copy()\n",
    "scorecard = scorecard.merge(phone_scores[['phone_id', 'p_rpc_beta', 'n_attempts', 'n_rpc']], on='phone_id', how='left')\n",
    "scorecard = scorecard.merge(hmm_df[['phone_id', 'p_valid', 'p_avoiding', 'p_switched_off', 'p_invalid', 'predicted_state']], on='phone_id', how='left')\n",
    "scorecard = scorecard.merge(phone_hazard[['phone_id', 'p_failure']], on='phone_id', how='left')\n",
    "scorecard['suppressed'] = scorecard['phone_id'].isin(suppression_list)\n",
    "\n",
    "# Assign action\n",
    "def assign_action(row):\n",
    "    if row['suppressed']:\n",
    "        return 'SUPPRESS'\n",
    "    state = row.get('predicted_state', 'unknown')\n",
    "    p_rpc = row.get('p_rpc_beta', 0.2)\n",
    "    if state == 'invalid':\n",
    "        return 'SUPPRESS'\n",
    "    if state == 'valid' and p_rpc >= 0.35:\n",
    "        return 'DIAL'\n",
    "    if state == 'avoiding':\n",
    "        return 'SWITCH_CHANNEL'\n",
    "    if state == 'switched_off':\n",
    "        return 'RETRY_48H'\n",
    "    if p_rpc < 0.1:\n",
    "        return 'SKIP_TRACE_CANDIDATE'\n",
    "    return 'DIAL'\n",
    "\n",
    "scorecard['action'] = scorecard.apply(assign_action, axis=1)\n",
    "\n",
    "# ─── EVT Skip-Trace Ranking ─────────────────────────────────────────────────────\n",
    "skip_candidates = scorecard[scorecard['action'] == 'SKIP_TRACE_CANDIDATE'].copy()\n",
    "skip_candidates = skip_candidates.merge(accts[['account_id', 'outstanding', 'ability_to_pay_estimate']], on='account_id', how='left')\n",
    "\n",
    "# P(find valid CP) from historical skip trace success rate\n",
    "p_find_cp = skips[skips['result'] == 'new_phone_found'].shape[0] / len(skips)\n",
    "\n",
    "# P(recover | reached) ~ ability_to_pay_estimate\n",
    "skip_candidates['p_recover'] = skip_candidates['ability_to_pay_estimate'].fillna(0.3).clip(0, 1)\n",
    "\n",
    "MEAN_TRACE_COST = skips['cost_inr'].mean()\n",
    "\n",
    "skip_candidates['EVT'] = (\n",
    "    p_find_cp *\n",
    "    skip_candidates['p_recover'] *\n",
    "    skip_candidates['outstanding'].fillna(5000) -\n",
    "    MEAN_TRACE_COST\n",
    ")\n",
    "skip_candidates['EVT_per_cost'] = skip_candidates['EVT'] / MEAN_TRACE_COST\n",
    "skip_candidates_ranked = skip_candidates.sort_values('EVT_per_cost', ascending=False)\n",
    "\n",
    "print('=== Action Distribution ===')\n",
    "print(scorecard['action'].value_counts())\n",
    "print()\n",
    "print(f'Skip-trace candidates: {len(skip_candidates_ranked):,}')\n",
    "print(f'P(find valid CP):      {p_find_cp:.1%} (from historical skips)')\n",
    "print(f'Mean trace cost:       ₹{MEAN_TRACE_COST:.0f}')\n",
    "print()\n",
    "print('Top 10 EVT Skip-Trace Candidates:')\n",
    "print(skip_candidates_ranked[['account_id', 'phone_id', 'outstanding', 'p_recover', 'EVT', 'EVT_per_cost']].head(10).to_string(index=False))"
   ]
  },
