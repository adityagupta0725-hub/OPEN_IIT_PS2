    "# ─── Step 4A: Discrete-Time Hazard Model ────────────────────────────────────────\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "\n",
    "# Event = phone becomes permanently non-contactable\n",
    "# We proxy: 'event' = phone had no RPC in last 10 attempts\n",
    "phone_hazard = (\n",
    "    dial3.sort_values(['phone_id', 'attempt_ts'])\n",
    "    .groupby('phone_id')\n",
    "    .agg(\n",
    "        total_attempts=('attempt_id', 'count'),\n",
    "        total_rpc=('is_rpc', 'sum'),\n",
    "        last_rpc_attempt=('attempt_ts', lambda x: x[dial3.loc[x.index, 'is_rpc'] == 1].max() if (dial3.loc[x.index, 'is_rpc'] == 1).any() else pd.NaT),\n",
    "        last_attempt=('attempt_ts', 'max'),\n",
    "        avg_ring=('ring_duration_s', 'mean'),\n",
    "        avg_talk=('talk_duration_s', 'mean'),\n",
    "        p_rpc=('is_rpc', 'mean')\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "phone_hazard = phone_hazard.merge(phone_scores[['phone_id', 'p_rpc_beta']], on='phone_id', how='left')\n",
    "phone_hazard['dead'] = ((phone_hazard['total_rpc'] == 0) & (phone_hazard['total_attempts'] >= 5)).astype(int)\n",
    "phone_hazard['log_attempts'] = np.log1p(phone_hazard['total_attempts'])\n",
    "\n",
    "haz_features = ['log_attempts', 'avg_ring', 'avg_talk', 'p_rpc_beta']\n",
    "haz_X = phone_hazard[haz_features].fillna(0)\n",
    "haz_y = phone_hazard['dead']\n",
    "\n",
    "haz_Xtr, haz_Xte, haz_ytr, haz_yte = train_test_split(haz_X, haz_y, test_size=0.2, random_state=42)\n",
    "haz_clf = LogisticRegression(max_iter=500, C=1.0)\n",
    "haz_clf.fit(haz_Xtr, haz_ytr)\n",
    "\n",
    "haz_auc = roc_auc_score(haz_yte, haz_clf.predict_proba(haz_Xte)[:, 1])\n",
    "print(f'Hazard Model AUC: {haz_auc:.4f}')\n",
    "print(f'Dead phone rate: {haz_y.mean():.2%}')\n",
    "\n",
    "phone_hazard['p_failure'] = haz_clf.predict_proba(haz_X)[:, 1]"
   ]
