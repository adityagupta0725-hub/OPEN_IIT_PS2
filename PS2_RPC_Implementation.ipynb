    "---\n",
    "## 🏷️ Step 1 — Label Engineering\n",
    "\n",
    "### Label Rules (from the strategy doc)\n",
    "| Signal | Label |\n",
    "|--------|-------|\n",
    "| `disposition` starts with `rpc_` AND payment within 48h | **valid** (strong) |\n",
    "| `disposition` starts with `rpc_` (no payment) | **valid** (weak) |\n",
    "| `network_response = number_does_not_exist` OR `disposition = invalid_number` | **invalid** |\n",
    "| `disposition` in `{third_party_contact, third_party_ptp}` | **third_party** |\n",
    "| `disposition = wrong_number` | **recycled** (candidate) |\n",
    "| `disposition = switched_off` | **switched_off** |\n",
    "| `network_response in {ring_no_answer, busy_rejected}` | **no_answer** (ambiguous — Step 3 resolves) |\n",
    "| Never-dialled numbers | **unknown** (not a negative!) |\n",
    "\n",
    "> ⚠️ **Critical:** Never label untested numbers as negatives — this causes the feedback-loop trap where we never try a number we've given up on."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─── Step 1: Label Engineering ──────────────────────────────────────────────────\n",
    "\n",
    "# 1A. Join payments to dial attempts (48-hour window)\n",
    "dial_pmt = dial.merge(\n",
    "    pmts[['account_id', 'payment_ts', 'amount']],\n",
    "    on='account_id', how='left'\n",
    ")\n",
    "dial_pmt['hours_to_payment'] = (\n",
    "    dial_pmt['payment_ts'] - dial_pmt['attempt_ts']\n",
    ").dt.total_seconds() / 3600\n",
    "dial_pmt['payment_within_48h'] = (\n",
    "    (dial_pmt['hours_to_payment'] >= 0) & (dial_pmt['hours_to_payment'] <= 48)\n",
    ")\n",
    "# Collapse: one row per attempt\n",
    "pmt_flag = dial_pmt.groupby('attempt_id')['payment_within_48h'].max().reset_index()\n",
    "pmt_flag.columns = ['attempt_id', 'pmt_48h']\n",
    "\n",
    "# 1B. Assign attempt-level label\n",
    "dial2 = dial.merge(pmt_flag, on='attempt_id', how='left')\n",
    "dial2['pmt_48h'] = dial2['pmt_48h'].fillna(False)\n",
    "\n",
    "def label_attempt(row):\n",
    "    d = row['disposition']\n",
    "    nr = row['network_response']\n",
    "    if d in ('invalid_number',) or nr == 'number_does_not_exist':\n",
    "        return 'invalid'\n",
    "    if d in ('third_party_contact', 'third_party_ptp'):\n",
    "        return 'third_party'\n",
    "    if d == 'wrong_number':\n",
    "        return 'recycled_candidate'\n",
    "    if d == 'switched_off':\n",
    "        return 'switched_off'\n",
    "    if d.startswith('rpc_'):\n",
    "        return 'valid_strong' if row['pmt_48h'] else 'valid_weak'\n",
    "    if nr in ('ring_no_answer', 'busy_rejected', 'not_reachable'):\n",
    "        return 'no_answer'  # ambiguous — resolved by GBDT\n",
    "    return 'unknown'\n",
    "\n",
    "dial2['state_label'] = dial2.apply(label_attempt, axis=1)\n",
    "\n",
    "# 1C. Phone-level label: last known state\n",
    "phone_state = (\n",
    "    dial2.sort_values('attempt_ts')\n",
    "    .groupby('phone_id')\n",
    "    .agg(\n",
    "        last_state=('state_label', 'last'),\n",
    "        n_attempts=('attempt_id', 'count'),\n",
    "        n_rpc=('is_rpc', 'sum'),\n",
    "        last_attempt_ts=('attempt_ts', 'max'),\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "print('=== Attempt-level labels ===')\n",
    "print(dial2['state_label'].value_counts())\n",
    "print()\n",
    "print('=== Phone-level last state ===')\n",
    "print(phone_state['last_state'].value_counts())"
   ]
