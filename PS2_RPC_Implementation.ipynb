    "---\n",
    "## 📉 Step 2 — Beta-Decay Baseline\n",
    "\n",
    "For each phone, estimate `P(RPC)` as a **time-weighted Beta-Bernoulli** posterior:\n",
    "\n",
    "$$P(\\text{RPC} | \\text{history}) = \\frac{\\alpha_0 + \\sum_i w_i \\cdot \\text{rpc}_i}{\\alpha_0 + \\beta_0 + \\sum_i w_i}$$\n",
    "\n",
    "where $w_i = e^{-\\lambda(t_{\\text{now}} - t_i)}$ so recent evidence counts more.\n",
    "\n",
    "This serves as a **calibrated baseline** that any later model must beat."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─── Step 2: Beta-Decay Baseline ────────────────────────────────────────────────\n",
    "from scipy.special import beta as beta_fn\n",
    "from sklearn.isotonic import IsotonicRegression\n",
    "\n",
    "LAMBDA = 0.05       # decay rate per day\n",
    "ALPHA0 = 1.0        # prior successes (optimistic)\n",
    "BETA0  = 3.0        # prior failures (contacts are hard)\n",
    "\n",
    "T_NOW = dial2['attempt_ts'].max()\n",
    "\n",
    "def beta_decay_rpc(group, lambda_=LAMBDA, alpha0=ALPHA0, beta0=BETA0, t_now=T_NOW):\n",
    "    \"\"\"Compute weighted Beta-Bernoulli posterior P(RPC) for one phone.\"\"\"\n",
    "    days_ago = (t_now - group['attempt_ts']).dt.total_seconds() / 86400\n",
    "    w = np.exp(-lambda_ * days_ago.clip(lower=0))\n",
    "    weighted_rpc = (w * group['is_rpc'].values).sum()\n",
    "    weighted_total = w.sum()\n",
    "    alpha_post = alpha0 + weighted_rpc\n",
    "    beta_post  = beta0 + weighted_total - weighted_rpc\n",
    "    p_rpc = alpha_post / (alpha_post + beta_post)\n",
    "    # 90% credible interval\n",
    "    from scipy import stats\n",
    "    lo, hi = stats.beta.ppf([0.05, 0.95], alpha_post, beta_post)\n",
    "    return pd.Series({'p_rpc_beta': p_rpc, 'ci_lo': lo, 'ci_hi': hi,\n",
    "                      'alpha_post': alpha_post, 'beta_post': beta_post,\n",
    "                      'n_attempts': len(group), 'n_rpc': int(group['is_rpc'].sum())})\n",
    "\n",
    "phone_scores = dial2.groupby('phone_id').apply(beta_decay_rpc).reset_index()\n",
    "\n",
    "# Merge with verified labels for calibration check\n",
    "vcp_map = {'borrower_number': 1, 'third_party_number': 0,\n",
    "           'not_borrower_number': 0, 'switched_off': 0, 'invalid_number': 0}\n",
    "vcp2 = vcp.copy()\n",
    "vcp2['true_rpc'] = vcp2['verified_status'].map(vcp_map)\n",
    "calib_df = phone_scores.merge(vcp2[['phone_id', 'true_rpc']], on='phone_id', how='inner')\n",
    "print(f'Calibration set: {len(calib_df)} verified phones')\n",
    "print(calib_df[['p_rpc_beta', 'true_rpc', 'ci_lo', 'ci_hi']].describe())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
