    "# ─── Step 4B: Simplified HMM State Posterior ────────────────────────────────────\n",
    "# We implement a 4-state discrete HMM for each phone:\n",
    "# States: 0=valid, 1=avoiding, 2=switched_off, 3=invalid\n",
    "# Observations: answered, ring_no_answer, busy, switched_off, doesnt_exist\n",
    "\n",
    "# Transition matrix (hand-initialised from domain knowledge, would be fitted with EM)\n",
    "A = np.array([\n",
    "    [0.90, 0.07, 0.02, 0.01],  # valid → ...\n",
    "    [0.10, 0.75, 0.10, 0.05],  # avoiding → ...\n",
    "    [0.02, 0.05, 0.85, 0.08],  # switched_off → ...\n",
    "    [0.00, 0.00, 0.05, 0.95],  # invalid → ...\n",
    "])\n",
    "\n",
    "# Emission probabilities B[state, obs_idx]\n",
    "# obs: 0=answered, 1=ring_no_answer, 2=busy, 3=switched_off, 4=doesnt_exist\n",
    "B = np.array([\n",
    "    [0.65, 0.25, 0.08, 0.01, 0.01],  # valid\n",
    "    [0.05, 0.55, 0.30, 0.08, 0.02],  # avoiding\n",
    "    [0.01, 0.05, 0.05, 0.85, 0.04],  # switched_off\n",
    "    [0.01, 0.10, 0.05, 0.10, 0.74],  # invalid\n",
    "])\n",
    "\n",
    "OBS_MAP = {\n",
    "    'answered': 0, 'ring_no_answer': 1, 'busy_rejected': 2,\n",
    "    'switched_off': 3, 'not_reachable': 3, 'number_does_not_exist': 4\n",
    "}\n",
    "\n",
    "def hmm_filter(obs_seq, A=A, B=B):\n",
    "    \"\"\"Forward-filter HMM given observation sequence. Returns final posterior.\"\"\"\n",
    "    n_states = A.shape[0]\n",
    "    alpha = np.ones(n_states) / n_states  # uniform prior\n",
    "    for obs in obs_seq:\n",
    "        alpha = (alpha @ A) * B[:, obs]\n",
    "        if alpha.sum() > 0:\n",
    "            alpha = alpha / alpha.sum()\n",
    "    return alpha  # posterior over states at last observation\n",
    "\n",
    "# Apply HMM to each phone\n",
    "def get_obs_seq(group):\n",
    "    return [OBS_MAP.get(nr, 1) for nr in group['network_response'].values]\n",
    "\n",
    "hmm_posteriors = []\n",
    "for phone_id, group in dial3.sort_values('attempt_ts').groupby('phone_id'):\n",
    "    obs = get_obs_seq(group)\n",
    "    posterior = hmm_filter(obs)\n",
    "    hmm_posteriors.append({\n",
    "        'phone_id': phone_id,\n",
    "        'p_valid': posterior[0],\n",
    "        'p_avoiding': posterior[1],\n",
    "        'p_switched_off': posterior[2],\n",
    "        'p_invalid': posterior[3],\n",
    "        'predicted_state': ['valid', 'avoiding', 'switched_off', 'invalid'][np.argmax(posterior)]\n",
    "    })\n",
    "\n",
    "hmm_df = pd.DataFrame(hmm_posteriors)\n",
    "print('HMM predicted state distribution:')\n",
    "print(hmm_df['predicted_state'].value_counts())"
   ]
  },
