   "source": [
    "# ─── Step 5: Recycled Number Detector ──────────────────────────────────────────\n",
    "import re\n",
    "\n",
    "# ─── 5A: NLP keyword detection ─────────────────────────────────────────────────\n",
    "RECYCLED_KEYWORDS = [\n",
    "    r'galat number', r'wrong number', r'galat no', r'yeh mera number nahi',\n",
    "    r'mera number nahi', r'ye number mera nahi', r'kisi aur ka', r'stranger',\n",
    "    r'different person', r'not my number', r'wrong person', r'kaun hai',\n",
    "    r'pehchanta nahi', r'not related', r'sim change', r'purana number',\n",
    "    r'yeh number kisi aur', r'naya number mila'\n",
    "]\n",
    "RECYCLED_PATTERN = re.compile('|'.join(RECYCLED_KEYWORDS), re.IGNORECASE)\n",
    "\n",
    "dial3['nlp_recycled'] = dial3['remark'].fillna('').str.contains(RECYCLED_PATTERN).astype(int)\n",
    "\n",
    "# ─── 5B: CUSUM change detection ────────────────────────────────────────────────\n",
    "def cusum_detect(series, k=0.5, h=3.0):\n",
    "    \"\"\"Page's CUSUM: detect upward shift in non-RPC rate. Returns True if change detected.\"\"\"\n",
    "    if len(series) < 5:\n",
    "        return False\n",
    "    # We track cumulative sum of (no-RPC indicator - k)\n",
    "    cusum = 0\n",
    "    for obs in series:\n",
    "        cusum = max(0, cusum + (1 - obs) - k)\n",
    "        if cusum >= h:\n",
    "            return True\n",
    "    return False\n",
    "\n",
    "cusum_flags = {}\n",
    "for phone_id, group in dial3.sort_values('attempt_ts').groupby('phone_id'):\n",
    "    rpc_seq = group['is_rpc'].values\n",
    "    cusum_flags[phone_id] = cusum_detect(rpc_seq)\n",
    "\n",
    "# ─── 5C: Combine signals → Suppression list ────────────────────────────────────\n",
    "nlp_phones = set(dial3[dial3['nlp_recycled'] == 1]['phone_id'].unique())\n",
    "cusum_phones = {pid for pid, flag in cusum_flags.items() if flag}\n",
    "\n",
    "# Ground-truth: verified non-borrower phones\n",
    "verified_suppress = set(\n",
    "    vcp[vcp['verified_status'].isin(['not_borrower_number', 'third_party_number', 'invalid_number'])]['phone_id']\n",
    ")\n",
    "\n",
    "suppression_list = nlp_phones | cusum_phones | verified_suppress\n",
    "\n",
    "print(f'NLP detections:        {len(nlp_phones):,}')\n",
    "print(f'CUSUM detections:      {len(cusum_phones):,}')\n",
    "print(f'Verified suppressed:   {len(verified_suppress):,}')\n",
    "print(f'Total suppression list:{len(suppression_list):,} unique phones')\n",
    "print(f'Suppression rate:      {len(suppression_list)/len(phones):.1%} of phone inventory')\n",
    "\n",
    "# Recall vs verified ground truth\n",
    "gt_suppress = set(vcp[vcp['verified_status'].isin(['not_borrower_number', 'third_party_number', 'invalid_number'])]['phone_id'])\n",
    "gt_borrower = set(vcp[vcp['verified_status'] == 'borrower_number']['phone_id'])\n",
    "\n",
    "tp = len(suppression_list & gt_suppress)\n",
    "fn = len(gt_suppress - suppression_list)\n",
    "fp = len(suppression_list & gt_borrower)\n",
    "\n",
